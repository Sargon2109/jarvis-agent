# Copy this file to .env and fill in your key. .env is gitignored.

# Your Anthropic API key — required for the LLM 'dump' flow (python main.py).
# The offline CLI (python -m jarvis ...) does NOT need this.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: relocate Jarvis's local data (all default to ./data/).
# Point these at a synced folder (OneDrive/Dropbox) to get backups for free.
# JARVIS_STORE_PATH=C:\Users\you\jarvis\plate.json
# JARVIS_DUMPS_PATH=C:\Users\you\jarvis\dumps.jsonl
# JARVIS_REGISTRY_PATH=C:\Users\you\jarvis\agents.json

# Optional: Canvas integration (python -m jarvis canvas).
# Base URL of your school's Canvas, then a personal access token generated
# in Canvas -> Account -> Settings -> New Access Token.
# JARVIS_CANVAS_URL=https://yourschool.instructure.com
# JARVIS_CANVAS_TOKEN=your-canvas-access-token
